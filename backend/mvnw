if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

MAVEN_VERSION="3.9.6"
MAVEN_HOME_DIR="$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION"
MAVEN_BIN="$MAVEN_HOME_DIR/apache-maven-$MAVEN_VERSION/bin/mvn"

if [ ! -x "$MAVEN_BIN" ]; then
  echo "[Maven Wrapper] Downloading Apache Maven $MAVEN_VERSION..."
  mkdir -p "$MAVEN_HOME_DIR"
  curl -fsSL "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.tar.gz" | tar -xz -C "$MAVEN_HOME_DIR"
fi

exec "$MAVEN_BIN" "$@"
